# SafeGlance backend configuration.
# Copy to .env (same folder, repo root) and fill in. Never commit the filled file.
# Every value here is a secret or tied to your accounts: do not paste any of them into a chat.

# Telegram user account (MTProto, GramJS). Get api_id / api_hash at https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Written by `npm run telegram:login`. Full access to the account: never print, share or commit it.
TELEGRAM_SESSION=

# Vault bot (Bot API), from @BotFather.
BOT_TOKEN=
# Your numeric Telegram user ID. Only this ID may read or edit the vault.
BOT_OWNER_TELEGRAM_ID=

# TON testnet payer wallet. TESTNET ONLY, test Gram from a faucet, never a wallet that holds real funds.
TON_TESTNET_PAYER_MNEMONIC=
# Wallet contract the mnemonic was created with: v5r1 (default, Tonkeeper W5) or v4r2.
TON_TESTNET_PAYER_WALLET_VERSION=v5r1
# toncenter testnet JSON-RPC, for example https://testnet.toncenter.com/api/v2/jsonRPC
TON_TESTNET_API_ENDPOINT=
# toncenter API key (from @toncenter on Telegram, pick testnet). Optional, raises the rate limit.
TON_TESTNET_API_KEY=

# Speech-to-text and LLM providers (chosen on Day 2+).
STT_API_KEY=
LLM_API_KEY=
