# Gramsight backend configuration.
# Copy to .env (same folder, repo root) and fill in. Never commit the filled file.
# Every value here is a secret or tied to your accounts: do not paste any of them into a chat.

# Telegram user account (TDLib). Get api_id / api_hash at https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Encryption key for TDLib's login database. Generated by `npm run telegram:login` if empty. Never share it.
TELEGRAM_TDLIB_DB_KEY=
# Where TDLib keeps the login database (full access to the account). Default: ~/.gramsight/tdlib, outside the repo.
TELEGRAM_TDLIB_DIR=

# Vault bot (Bot API), from @BotFather.
BOT_TOKEN=
# Your numeric Telegram user ID. Only this ID may read or edit the vault.
# Filled by `npm run telegram:login` if empty.
BOT_OWNER_TELEGRAM_ID=

# TON testnet payer wallet. TESTNET ONLY, free test Gram from a faucet.
# Leave empty and run `npm run ton:new-payer`: it generates the mnemonic here (never printed) and shows the address to fund.
# NEVER put your real Gram Wallet (the wallet inside Telegram) here: that is mainnet and holds real funds.
TON_TESTNET_PAYER_MNEMONIC=
# Wallet contract: v5r1 (default, W5 with the testnet wallet id) or v4r2 (only if you bring a v4r2 testnet wallet).
TON_TESTNET_PAYER_WALLET_VERSION=v5r1
# toncenter testnet JSON-RPC. Defaults to this if empty.
TON_TESTNET_API_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
# toncenter API key (from @toncenter on Telegram, pick testnet). Optional, raises the rate limit.
TON_TESTNET_API_KEY=

# Speech-to-text provider (to be chosen).
STT_API_KEY=
# Optional: Claude API key for command phrasing the built-in rules don't understand (from console.anthropic.com).
# Unset = rules only, nothing billed. LLM_API_KEY is accepted as an older name for the same thing.
ANTHROPIC_API_KEY=
# Optional model override for that fallback (default claude-opus-5-5).
GRAMSIGHT_INTENT_MODEL=

# Flow A behaviour. Sending as your account stays a dry run (logged only) until this is "live".
GRAMSIGHT_SEND=dry-run
GRAMSIGHT_DEV=
