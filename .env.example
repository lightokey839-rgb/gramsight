# Gramsight backend configuration.
# Copy to .env (same folder, repo root) and fill in. Never commit the filled file.
# Every value here is a secret or tied to your accounts: do not paste any of them into a chat.

# Telegram user account (TDLib). Get api_id / api_hash at https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Encryption key for TDLib's login database. Generated by `npm run telegram:login` if empty. Never share it.
TELEGRAM_TDLIB_DB_KEY=
# Where TDLib keeps the login database (full access to the account). Default: ~/.gramsight/tdlib, outside the repo.
TELEGRAM_TDLIB_DIR=

# Vault bot (Bot API), from @BotFather.
BOT_TOKEN=
# Your numeric Telegram user ID. Only this ID may read or edit the vault.
# Filled by `npm run telegram:login` if empty.
BOT_OWNER_TELEGRAM_ID=

# TON testnet payer wallet. TESTNET ONLY, free test Gram from a faucet.
# Leave empty and run `npm run ton:new-payer`: it generates the mnemonic here (never printed) and shows the address to fund.
# NEVER put your real Gram Wallet (the wallet inside Telegram) here: that is mainnet and holds real funds.
TON_TESTNET_PAYER_MNEMONIC=
# Wallet contract: v5r1 (default, W5 with the testnet wallet id) or v4r2 (only if you bring a v4r2 testnet wallet).
TON_TESTNET_PAYER_WALLET_VERSION=v5r1
# toncenter testnet JSON-RPC. Defaults to this if empty.
TON_TESTNET_API_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
# toncenter API key (from @toncenter on Telegram, pick testnet). Optional, raises the rate limit.
TON_TESTNET_API_KEY=

# AI (AI Assistants track). Default: OpenRouter free models (openrouter.ai -> Keys). Unset = rules and fixed templates only.
# The AI only classifies what you said and explains verdicts; it never sees an address.
OPENROUTER_API_KEY=
# openrouter (default when the key is set) | claude | off
GRAMSIGHT_AI=
# Model id(s), comma-separated; the next is tried when one is rate-limited.
# Default: nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free (free model ids come and go).
GRAMSIGHT_INTENT_MODEL=
# Requests per day before "AI busy" (OpenRouter free models allow about 50 a day).
GRAMSIGHT_AI_DAILY_LIMIT=40
# Only with GRAMSIGHT_AI=claude (paid): console.anthropic.com. LLM_API_KEY is accepted as an older name.
ANTHROPIC_API_KEY=
# Old name, unused.
STT_API_KEY=

# Flow A behaviour. Sending as your account stays a dry run (logged only) until this is "live".
GRAMSIGHT_SEND=dry-run
GRAMSIGHT_DEV=

# Flow B payments on TON TESTNET from the payer wallet. Dry run (logged only) until this is "live".
GRAMSIGHT_PAY=dry-run
# Limits in Gram: per payment, and per rolling 24 hours.
GRAMSIGHT_MAX_PAYMENT_GRAM=1
GRAMSIGHT_DAILY_LIMIT_GRAM=3
# Optional tonapi.io key (higher rate limits for the scam check).
TONAPI_KEY=

# Path 2: TON Connect to YOUR OWN testnet wallet app (new addresses, warnings, larger payments).
# Public HTTPS URL of docs/tonconnect/tonconnect-manifest.json, e.g. once the repo is public on GitHub:
# https://raw.githubusercontent.com/<you>/gramsight/main/docs/tonconnect/tonconnect-manifest.json
GRAMSIGHT_TONCONNECT_MANIFEST_URL=
# Max Gram per wallet-approved payment.
GRAMSIGHT_WALLET_MAX_GRAM=10

# Speech-to-text: Groq free plan (console.groq.com -> API Keys), model whisper-large-v3-turbo.
GROQ_API_KEY=
